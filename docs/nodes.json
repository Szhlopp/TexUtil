      "angle": {
        "default": 0.0,
        "description": "Stamp clockwise angle.",
        "max": 36000.0,
        "min": -36000.0,
        "type": "number"
      },
      "count": {
        "default": [
          4,
          4
        ],
        "description": "Grid [columns,rows], maximum 10000 total.",
