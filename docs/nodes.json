      },
      "mode": {
        "default": "over",
        "description": "Overlap/blend operation.",
        "enum": [
          "over",
          "mix",
          "multiply",
          "add",
          "subtract",
          "screen",
          "overlay",
          "min",
          "max",
          "difference"
