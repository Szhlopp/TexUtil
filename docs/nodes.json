{
  "array": {
    "description": "Grid sampler with optional source variation and control maps.",
    "parameters": {
      "angle": {
        "default": 0.0,
        "description": "Stamp clockwise angle.",
        "max": 36000.0,
        "min": -36000.0,
        "type": "number"
      },
      "count": {
        "default": [
          4,
          4
        ],
        "description": "Grid [columns,rows], maximum 10000 total.",
        "type": "count_pair"
      },
      "direction": {
        "default": null,
        "description": "Clamped luminance adds 0..360 degrees at each stamp center.",
        "type": "reference"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "jitter": {
        "default": 0.0,
        "description": "Position jitter as a fraction of each grid cell.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "mask": {
        "default": null,
        "description": "Density probability from clamped luminance at each candidate center.",
        "type": "reference"
      },
      "mode": {
        "default": "max",
        "description": "Overlap/blend operation.",
        "enum": [
          "over",
          "mix",
          "multiply",
          "add",
          "subtract",
          "screen",
          "overlay",
          "min",
          "max",
          "difference"
        ],
        "type": "string"
      },
      "opacity": {
        "default": 1.0,
        "description": "Blend strength, 0 to 1.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "rotation_jitter": {
        "default": 0.0,
        "description": "Random +/- angle in degrees.",
        "max": 360.0,
        "min": 0.0,
        "type": "number"
      },
      "row_offset": {
        "default": 0.0,
        "description": "Odd grid rows shift by this fraction of a cell; array only.",
        "max": 1.0,
        "min": -1.0,
        "type": "number"
      },
      "scale_map": {
        "default": null,
        "description": "Clamped luminance multiplies stamp size; black skips stamp.",
        "type": "reference"
      },
      "seed": {
        "default": null,
        "description": "Override document seed.",
        "type": "seed"
      },
      "size": {
        "default": 0.1,
        "description": "Stamp full width/height in UV units.",
        "type": "positive_pair"
      },
      "size_jitter": {
        "default": 0.0,
        "description": "Uniform random +/- fraction of size.",
        "max": 0.99,
        "min": 0.0,
        "type": "number"
      },
      "sources": {
        "default": [],
        "description": "Additional source nodes; select uniformly including input.",
        "type": "references"
      },
      "value_map": {
        "default": null,
        "description": "Clamped luminance multiplies stamp RGB/value.",
        "type": "reference"
      },
      "value_range": {
        "default": [
          1,
          1
        ],
        "description": "Uniform random stamp value multiplier [min,max] within 0..1.",
        "type": "pair"
      },
      "wrap": {
        "default": false,
        "description": "Wrap stamps across output boundaries; max stamp size 1 UV.",
        "type": "boolean"
      }
    }
  },
  "auto_levels": {
    "description": "Stretch observed RGB range to requested range; scalar uses its single channel. Constant channels map to lower output bound.",
    "parameters": {
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "per_channel": {
        "default": false,
        "description": "Use separate RGB extrema; false shares one RGB range.",
        "type": "boolean"
      },
      "range": {
        "default": [
          0,
          1
        ],
        "description": "Ordered output range.",
        "type": "pair"
      }
    }
  },
  "bevel": {
    "description": "Turn a binary silhouette into a raised heightfield using inside Euclidean distance.",
    "parameters": {
      "edge": {
        "default": "repeat",
        "description": "Boundary sampling.",
        "enum": [
          "repeat",
          "clamp",
          "transparent"
        ],
        "type": "string"
      },
      "height": {
        "default": 1.0,
        "description": "Maximum bevel height.",
        "max": 10000.0,
        "min": 0.0,
        "type": "number"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "profile": {
        "default": "smooth",
        "description": "Bevel height profile over inside distance.",
        "enum": [
          "linear",
          "smooth",
          "round"
        ],
        "type": "string"
      },
      "radius": {
        "default": 16.0,
        "description": "Pixel distance that maps to 1; distances saturate.",
        "max": 32768.0,
        "min": 0.01,
        "type": "number"
      },
      "threshold": {
        "default": 0.5,
        "description": "Foreground is luminance >= threshold.",
        "max": 10000.0,
        "min": -10000.0,
        "type": "number"
      }
    }
  },
  "blend": {
    "description": "Combine two fields, optionally through a scalar mask.",
    "parameters": {
      "a": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "b": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "mask": {
        "default": null,
        "description": "Optional mask node; clamped luminance multiplies opacity.",
        "type": "reference"
      },
      "mode": {
        "default": "over",
        "description": "Overlap/blend operation.",
        "enum": [
          "over",
          "mix",
          "multiply",
          "add",
          "subtract",
          "screen",
          "overlay",
          "min",
          "max",
          "difference"
        ],
        "type": "string"
      },
      "opacity": {
        "default": 1.0,
        "description": "Blend strength, 0 to 1.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      }
    }
  },
  "blue_noise": {
    "description": "Toroidal best-candidate point mask, not a ranked blue-noise dither texture. Generation is O(candidates * count squared).",
    "parameters": {
      "candidates": {
        "default": 16.0,
        "description": "Candidates compared per point; higher gives more even spacing.",
        "max": 64.0,
        "min": 1.0,
        "type": "integer"
      },
      "count": {
        "default": 512.0,
        "description": "Number of points.",
        "max": 4096.0,
        "min": 1.0,
        "type": "integer"
      },
      "radius": {
        "default": 1.5,
        "description": "Antialiased dot radius in pixels.",
        "max": 32.0,
        "min": 0.1,
        "type": "number"
      },
      "seed": {
        "default": null,
        "description": "Override document seed.",
        "type": "seed"
      }
    }
  },
  "blur": {
    "description": "Separable box blur, optionally repeated to approximate Gaussian blur.",
    "parameters": {
      "edge": {
        "default": "repeat",
        "description": "Sampling outside the source.",
        "enum": [
          "repeat",
          "clamp",
          "transparent"
        ],
        "type": "string"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "passes": {
        "default": 3.0,
        "description": "Repeated box passes.",
        "max": 6.0,
        "min": 1.0,
        "type": "integer"
      },
      "radius": {
        "default": 3.0,
        "description": "Box radius in pixels.",
        "max": 2048.0,
        "min": 0.0,
        "type": "integer"
      }
    }
  },
  "checker": {
    "description": "Alternating scalar squares.",
    "parameters": {
      "count": {
        "default": [
          8,
          8
        ],
        "description": "Cell counts [columns,rows].",
        "type": "count_pair"
      }
    }
  },
  "clouds": {
    "description": "Scalar clouds noise, backed by FastNoise2.",
    "parameters": {
      "angle": {
        "default": 0.0,
        "description": "Clockwise degrees; 0 points right.",
        "max": 36000.0,
        "min": -36000.0,
        "type": "number"
      },
      "fractal": {
        "default": "fbm",
        "description": "Fractal noise combination.",
        "enum": [
          "none",
          "fbm",
          "ridged"
        ],
        "type": "string"
      },
      "gain": {
        "default": 0.5,
        "description": "Amplitude multiplier per octave.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "lacunarity": {
        "default": 2.0,
        "description": "Frequency multiplier per octave.",
        "max": 4.0,
        "min": 1.0,
        "type": "number"
      },
      "octaves": {
        "default": 5.0,
        "description": "Number of fractal octaves.",
        "max": 12.0,
        "min": 1.0,
        "type": "integer"
      },
      "scale": {
        "default": 8.0,
        "description": "Noise frequency across a unit image; larger gives smaller features.",
        "max": 4096.0,
        "min": 0.001,
        "type": "number"
      },
      "seed": {
        "default": null,
        "description": "Override document seed; omitted uses document seed.",
        "type": "seed"
      },
      "stretch": {
        "default": 1,
        "description": "Feature stretch [x,y] in the generation domain, before rasterization.",
        "type": "positive_pair"
      },
      "tile": {
        "default": null,
        "description": "Override document tile setting; uses 4D torus sampling.",
        "type": "boolean"
      }
    }
  },
  "constant": {
    "description": "Solid scalar or linear color. Hex strings are decoded from sRGB.",
    "parameters": {
      "value": {
        "default": 0.0,
        "description": "Number, #RRGGBB[AA], or linear [r,g,b,a].",
        "type": "color"
      }
    }
  },
  "directional_blur": {
    "description": "Uniform line blur with bilinear taps and premultiplied alpha.",
    "parameters": {
      "angle": {
        "default": 0.0,
        "description": "Clockwise degrees; 0 points right.",
        "max": 36000.0,
        "min": -36000.0,
        "type": "number"
      },
      "edge": {
        "default": "repeat",
        "description": "Boundary sampling.",
        "enum": [
          "repeat",
          "clamp",
          "transparent"
        ],
        "type": "string"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "length": {
        "default": 12.0,
        "description": "Full line length in pixels.",
        "max": 4096.0,
        "min": 0.0,
        "type": "number"
      },
      "samples": {
        "default": 17.0,
        "description": "Uniform taps; increase for long blur lengths.",
        "max": 513.0,
        "min": 2.0,
        "type": "integer"
      }
    }
  },
  "directional_warp": {
    "description": "Displace the source along one direction, optionally controlled by a grayscale image or channel.",
    "parameters": {
      "angle": {
        "default": 0.0,
        "description": "Clockwise sampling direction: 0 right, 90 down. Visible content moves oppositely.",
        "max": 36000.0,
        "min": -36000.0,
        "type": "number"
      },
      "channel": {
        "default": "luminance",
        "description": "Channel of intensity; scalar fields work directly. Values clamp to 0..1.",
        "enum": [
          "luminance",
          "r",
          "g",
          "b",
          "a"
        ],
        "type": "string"
      },
      "edge": {
        "default": "repeat",
        "description": "Sampling outside the source.",
        "enum": [
          "repeat",
          "clamp",
          "transparent"
        ],
        "type": "string"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "intensity": {
        "default": null,
        "description": "Optional control node; omission supplies white (1) everywhere.",
        "type": "reference"
      },
      "midlevel": {
        "default": 0.0,
        "description": "Neutral intensity; 0 makes black stationary, 0.5 gives signed displacement.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "strength": {
        "default": 0.05,
        "description": "UV displacement = strength * (intensity - midlevel).",
        "max": 10.0,
        "min": -10.0,
        "type": "number"
      }
    }
  },
  "distance": {
    "description": "Exact Euclidean distance to nearest opposite-class pixel center, normalized by radius. Repeat is periodic; transparent adds virtual background outside.",
    "parameters": {
      "edge": {
        "default": "repeat",
        "description": "Boundary sampling.",
        "enum": [
          "repeat",
          "clamp",
          "transparent"
        ],
        "type": "string"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "radius": {
        "default": 16.0,
        "description": "Pixel distance that maps to 1; distances saturate.",
        "max": 32768.0,
        "min": 0.01,
        "type": "number"
      },
      "side": {
        "default": "inside",
        "description": "Inside to background, outside to foreground, or signed with boundary centered at 0.5.",
        "enum": [
          "inside",
          "outside",
          "signed"
        ],
        "type": "string"
      },
      "threshold": {
        "default": 0.5,
        "description": "Foreground is luminance >= threshold.",
        "max": 10000.0,
        "min": -10000.0,
        "type": "number"
      }
    }
  },
  "erode": {
    "description": "Conservative heightfield weathering: wind transport, rain water/sediment flow, or time thermal relaxation. Pixel-scale artistic simulation, not a calibrated physical solver.",
    "parameters": {
      "angle": {
        "default": 0.0,
        "description": "Clockwise degrees; 0 points right.",
        "max": 36000.0,
        "min": -36000.0,
        "type": "number"
      },
      "capacity": {
        "default": 8.0,
        "description": "Rain sediment capacity coefficient.",
        "max": 100.0,
        "min": 0.0,
        "type": "number"
      },
      "deposition": {
        "default": 0.3,
        "description": "Excess rain sediment deposition fraction per step.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "distance": {
        "default": 2.0,
        "description": "Wind transport distance in pixels.",
        "max": 128.0,
        "min": 0.0,
        "type": "number"
      },
      "edge": {
        "default": "repeat",
        "description": "Periodic or closed boundary; both retain material.",
        "enum": [
          "repeat",
          "clamp"
        ],
        "type": "string"
      },
      "evaporation": {
        "default": 0.1,
        "description": "Water evaporation fraction per step; deposits that fraction of sediment.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "iterations": {
        "default": 32.0,
        "description": "Simulation steps; zero returns grayscale input.",
        "max": 512.0,
        "min": 0.0,
        "type": "integer"
      },
      "mask": {
        "default": null,
        "description": "Optional clamped mobility mask; rain/wind deposition can land on protected pixels.",
        "type": "reference"
      },
      "mode": {
        "default": "time",
        "description": "Erosion model.",
        "enum": [
          "wind",
          "rain",
          "time"
        ],
        "type": "string"
      },
      "rainfall": {
        "default": 0.01,
        "description": "Water added per rain step, with seeded spatial variation.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "rate": {
        "default": 0.3,
        "description": "Erosion/relaxation rate per step.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "seed": {
        "default": null,
        "description": "Override document seed.",
        "type": "seed"
      },
      "talus": {
        "default": 0.005,
        "description": "Stable height drop per pixel (time/wind).",
        "max": 10000.0,
        "min": 0.0,
        "type": "number"
      }
    }
  },
  "gaussian_blur": {
    "description": "Separable Gaussian convolution, radius ceil(3*sigma), normalized discrete weights and premultiplied alpha.",
    "parameters": {
      "edge": {
        "default": "repeat",
        "description": "Boundary sampling.",
        "enum": [
          "repeat",
          "clamp",
          "transparent"
        ],
        "type": "string"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "sigma": {
        "default": 2.0,
        "description": "Standard deviation in pixels; zero is identity.",
        "max": 128.0,
        "min": 0.0,
        "type": "number"
      }
    }
  },
  "gaussian_noise": {
    "description": "Independent Gaussian pixel values, clipped to 0..1. Not a blurred noise.",
    "parameters": {
      "deviation": {
        "default": 0.15,
        "description": "Standard deviation before clipping.",
        "max": 10.0,
        "min": 0.0,
        "type": "number"
      },
      "mean": {
        "default": 0.5,
        "description": "Distribution mean before clipping.",
        "max": 10.0,
        "min": -10.0,
        "type": "number"
      },
      "seed": {
        "default": null,
        "description": "Override document seed.",
        "type": "seed"
      }
    }
  },
  "gradient": {
    "description": "Linear, radial or angular scalar gradient.",
    "parameters": {
      "angle": {
        "default": 0.0,
        "description": "Clockwise degrees; 0 runs left to right.",
        "max": 36000.0,
        "min": -36000.0,
        "type": "number"
      },
      "center": {
        "default": [
          0.5,
          0.5
        ],
        "description": "Center in normalized image coordinates.",
        "type": "pair"
      },
      "radius": {
        "default": 0.5,
        "description": "Radial range in UV units.",
        "max": 16.0,
        "min": 0.0001,
        "type": "number"
      },
      "reverse": {
        "default": false,
        "description": "Invert gradient.",
        "type": "boolean"
      },
      "type": {
        "default": "linear",
        "description": "Gradient geometry.",
        "enum": [
          "linear",
          "radial",
          "angular"
        ],
        "type": "string"
      }
    }
  },
  "grayscale": {
    "description": "Linear Rec.709 luminance; discards alpha.",
    "parameters": {
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      }
    }
  },
  "image": {
    "description": "Import a PNG and resize to document dimensions.",
    "parameters": {
      "kind": {
        "default": "color",
        "description": "Interpretation of pixel values.",
        "enum": [
          "color",
          "scalar",
          "normal"
        ],
        "type": "string"
      },
      "path": {
        "description": "PNG path relative to the JSON file.",
        "required": true,
        "type": "string"
      },
      "srgb": {
        "default": true,
        "description": "Decode sRGB for color inputs; ignored for data.",
        "type": "boolean"
      }
    }
  },
  "invert": {
    "description": "Invert RGB/scalar values, preserving alpha.",
    "parameters": {
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      }
    }
  },
  "levels": {
    "description": "Clamp input range, apply gamma, map to output range.",
    "parameters": {
      "gamma": {
        "default": 1.0,
        "description": "Exponent uses 1/gamma.",
        "max": 100.0,
        "min": 0.01,
        "type": "number"
      },
      "in": {
        "default": [
          0,
          1
        ],
        "description": "Strictly increasing input range.",
        "type": "pair"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "out": {
        "default": [
          0,
          1
        ],
        "description": "Output range; may be reversed.",
        "type": "pair"
      }
    }
  },
  "math": {
    "description": "Component-wise field arithmetic, preserving input alpha. Nonfinite results fail rendering.",
    "parameters": {
      "b": {
        "default": null,
        "description": "Optional second field; overrides value.",
        "type": "reference"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "mode": {
        "default": "multiply",
        "description": "Divide by |b| < 1e-8 returns 0; pow clamps base to >=0 and defines 0 to negative powers as 0.",
        "enum": [
          "add",
          "subtract",
          "multiply",
          "divide",
          "min",
          "max",
          "pow",
          "abs",
          "clamp",
          "fract",
          "quantize"
        ],
        "type": "string"
      },
      "range": {
        "default": [
          0,
          1
        ],
        "description": "Clamp limits, or quantization range; ordered.",
        "type": "pair"
      },
      "steps": {
        "default": 8.0,
        "description": "Quantization levels including both endpoints.",
        "max": 4096.0,
        "min": 2.0,
        "type": "integer"
      },
      "value": {
        "default": 1.0,
        "description": "Second operand when b is absent.",
        "max": 10000.0,
        "min": -10000.0,
        "type": "number"
      }
    }
  },
  "normal": {
    "description": "Convert scalar height to a tangent-space normal using central differences.",
    "parameters": {
      "convention": {
        "default": "directx",
        "description": "DirectX uses +height derivative in image Y for green; OpenGL flips green.",
        "enum": [
          "directx",
          "opengl"
        ],
        "type": "string"
      },
      "edge": {
        "default": "repeat",
        "description": "Sampling outside the source.",
        "enum": [
          "repeat",
          "clamp",
          "transparent"
        ],
        "type": "string"
      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "strength": {
        "default": 1.0,
        "description": "Height scale per unit UV; resolution independent.",
        "max": 1000.0,
        "min": 0.0,
        "type": "number"
      }
    }
  },
  "pack": {
    "description": "Pack scalar node luminances into RGBA, tagged as linear data.",
    "parameters": {
      "a": {
        "default": null,
        "description": "Optional alpha source; defaults to 1.",
        "type": "reference"
      },
      "b": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "g": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "r": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      }
    }
  },
  "perlin": {
    "description": "Scalar perlin noise, backed by FastNoise2.",
    "parameters": {
      "angle": {
        "default": 0.0,
        "description": "Clockwise degrees; 0 points right.",
        "max": 36000.0,
        "min": -36000.0,
        "type": "number"
      },
      "fractal": {
        "default": "none",
        "description": "Fractal noise combination.",
        "enum": [
          "none",
          "fbm",
          "ridged"
        ],
        "type": "string"
