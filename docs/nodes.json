      },
      "input": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "jitter": {
        "default": 0.0,
        "description": "Position jitter as a fraction of each grid cell.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "mode": {
        "default": "max",
        "description": "Overlap/blend operation.",
        "enum": [
          "over",
          "mix",
          "multiply",
          "add",
          "subtract",
          "screen",
          "overlay",
          "min",
          "max",
          "difference"
        ],
        "type": "string"
      },
      "opacity": {
        "default": 1.0,
        "description": "Blend strength, 0 to 1.",
        "max": 1.0,
        "min": 0.0,
        "type": "number"
      },
      "rotation_jitter": {
        "default": 0.0,
        "description": "Random +/- angle in degrees.",
        "max": 360.0,
        "min": 0.0,
        "type": "number"
      },
      "seed": {
        "default": null,
        "description": "Override document seed.",
        "type": "seed"
      },
      "size": {
        "default": 0.1,
        "description": "Stamp full width/height in UV units.",
        "type": "positive_pair"
      },
      "wrap": {
        "default": false,
        "description": "Wrap stamps across output boundaries; max stamp size 1 UV.",
        "type": "boolean"
      }
    }
  },
  "blend": {
    "description": "Combine two fields, optionally through a scalar mask.",
    "parameters": {
      "a": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "b": {
        "description": "Source node name.",
        "required": true,
        "type": "reference"
      },
      "mask": {
        "default": null,
        "description": "Optional mask node; clamped luminance multiplies opacity.",
