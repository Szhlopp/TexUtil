# Pinned, hash-checked source dependencies for CPU model operations.
set(TEXUTIL_MODEL_DEPS "${CMAKE_BINARY_DIR}/_deps/texutil-models")
function(texutil_model_file component filename url digest)
  set(destination "${TEXUTIL_MODEL_DEPS}/${component}/${filename}")
  file(MAKE_DIRECTORY "${TEXUTIL_MODEL_DEPS}/${component}")
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" actual)
  endif()
  if(NOT actual STREQUAL digest)
    file(DOWNLOAD "${url}" "${destination}" EXPECTED_HASH "SHA256=${digest}" TLS_VERIFY ON)
  endif()
endfunction()
